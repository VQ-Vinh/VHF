/* PRANA ELEX stylesheet template.
   Every colour is a token placeholder filled in by ui/theme.py.
   Never write a hex literal here, and never a dollar-brace in a comment. */

QMainWindow, QDialog, QWidget {
    background-color: ${canvas};
    color: ${text};
    font-family: "Segoe UI", "Noto Sans", sans-serif;
    font-size: 13px;
}
QLabel { color: ${text}; background: transparent; }
QToolTip {
    background: ${tooltip_bg}; color: ${tooltip_text}; border: none;
    border-radius: 6px; padding: 6px 9px;
}

/* Header */
#LocaleSelector {
    min-width: 64px; max-width: 64px; min-height: 36px; max-height: 36px;
    background: ${input_bg}; color: ${text};
    border: 1px solid ${input_border}; border-radius: 8px; padding: 0 8px;
    font-weight: 700;
}
#RxLabel { font-size: 10px; font-weight: 750; letter-spacing: .5px; color: ${console_muted}; }

/* Language strip */
#LangLabel, #FeedHeader {
    font-size: 10px; font-weight: 750; letter-spacing: .8px; color: ${text_muted};
}

QComboBox, QLineEdit, QSpinBox {
    min-height: 36px; background: ${input_bg}; color: ${text};
    border: 1px solid ${input_border}; border-radius: 8px;
    padding: 0 11px; selection-background-color: ${selection_bg};
}
QComboBox:hover, QLineEdit:hover, QSpinBox:hover { border-color: ${border_strong}; }
QComboBox:focus, QLineEdit:focus, QSpinBox:focus { border: 2px solid ${focus}; }
QComboBox::drop-down { border: none; width: 26px; }
QComboBox QAbstractItemView {
    background: ${input_bg}; color: ${text}; border: 1px solid ${input_border};
    selection-background-color: ${selection_bg}; selection-color: ${selection_text}; padding: 5px;
}
QCheckBox { color: ${text}; spacing: 8px; }

/* Translation feed */
#ChatFeed, #ChatScroll, #ChatScroll > QWidget, #ChatContent { background: ${console_bg}; border: none; }
#FeedHeader { padding: 13px 0 9px 0; }
#FeedEmptyState { background: transparent; border: none; }
#FeedEmptyTitle { font-size: 18px; font-weight: 700; color: ${console_ink}; }
#FeedEmptyBody { font-size: 13px; color: ${console_muted}; padding-top: 4px; }
#ChatBubble {
    background: ${console_panel}; border: 1px solid ${hairline};
    border-radius: 12px; margin: 6px 0; padding: 0 16px;
}
#ChatSource { font-size: 10px; font-weight: 750; color: ${console_muted}; letter-spacing: .25px; }
#ChatTranscript { font-size: 15px; font-weight: 450; color: ${text_secondary}; }
#ChatTranslation { font-size: 18px; font-weight: 700; color: ${console_ink}; }
#HistoryButton {
    min-width: 34px; max-width: 34px; min-height: 34px; max-height: 34px;
    padding: 0; background: transparent; border: 1px solid transparent; border-radius: 8px;
}
#HistoryButton:hover { background: ${button_hover}; border-color: ${border}; }

/* Status */
#StatusBar { background: ${console_panel}; border-top: 1px solid ${hairline}; }
#ListeningDot, #GcsDot { font-size: 8px; }
#ListeningLabel, #GcsLabel {
    font-size: 10px; font-weight: 750; letter-spacing: .4px; color: ${console_ink};
}

/* Buttons */
QPushButton {
    min-height: 36px; background: ${button_bg}; color: ${text};
    border: 1px solid ${border}; border-radius: 8px;
    padding: 0 16px; font-size: 12px; font-weight: 650;
}
QPushButton:hover { background: ${button_hover}; border-color: ${border_strong}; color: ${text}; }
QPushButton:pressed { background: ${button_pressed}; }
QPushButton:disabled { color: ${text_disabled}; border-color: ${border}; background: ${button_disabled_bg}; }
#PrimaryButton, QPushButton#StartStopButton[mode="start"] {
    background: ${accent}; color: ${on_accent}; border-color: ${accent}; font-weight: 750;
}
#PrimaryButton:hover, QPushButton#StartStopButton[mode="start"]:hover {
    background: ${accent_hover}; border-color: ${accent_hover}; color: ${on_accent};
}
#StartStopButton { min-width: 92px; padding: 0 16px; }
QPushButton#StartStopButton[mode="stop"] { background: ${stop}; color: ${on_stop}; border-color: ${stop}; font-weight: 750; }
QPushButton#StartStopButton[mode="stop"]:hover { background: ${stop_hover}; border-color: ${stop_hover}; color: ${on_stop}; }
QPushButton#StartStopButton[mode="transition"] { background: ${button_hover}; color: ${text_muted}; border-color: ${border}; }
#SettingsButton {
    background: transparent; border: 1px solid transparent; border-radius: 8px; padding: 0;
}
#SettingsButton:hover { background: ${button_hover}; border-color: ${border}; }

/* Account pages */
#AccountCard {
    background: ${surface}; border: 1px solid ${border}; border-radius: 12px;
}
#AccountTitle { color: ${text}; font-size: 25px; font-weight: 750; }
#AccountSubtitle { color: ${text_muted}; font-size: 13px; }
#AccountCard QLineEdit { min-height: 40px; font-size: 13px; }
#AccountCard QPushButton { min-height: 40px; font-size: 13px; }
#AccountCard QCheckBox { min-height: 30px; color: ${text}; }
#PasswordRequirements { font-size: 11px; line-height: 1.35; color: ${text_muted}; }
#GoogleButton {
    min-height: 44px; background: ${surface}; color: ${text};
    border: 1px solid ${border_strong}; font-weight: 700; text-align: center;
}
#GoogleButton:hover { background: ${surface_muted}; border-color: ${border_strong}; }
#GoogleCancelButton { min-height: 44px; }
#AuthDividerText { color: ${text_muted}; font-size: 11px; }
#PasswordToggle {
    min-height: 30px; max-width: 170px; padding: 0;
    background: transparent; border: none; color: ${text_secondary}; text-align: left;
}
#PasswordToggle:hover, #PasswordToggle:checked {
    background: transparent; border: none; color: ${focus};
}
QTabWidget::pane { border: 1px solid ${border}; border-radius: 8px; background: ${surface}; padding: 10px; }
QTabBar::tab {
    min-height: 26px; background: ${button_hover}; color: ${text_muted};
    padding: 9px 22px; border: 1px solid ${border};
}
QTabBar::tab:selected { background: ${surface}; color: ${accent}; border-bottom: 2px solid ${accent}; }

/* Account center */
#AccountCenterPage, #AccountCenterScroll, #AccountCenterBody { background: ${canvas}; border: none; }
#AccountCenterTitle { font-size: 25px; font-weight: 750; color: ${text}; }
#AccountCenterSubtitle, #AccountCenterMuted { color: ${text_muted}; }
#AccountCenterSectionTitle { font-size: 15px; font-weight: 750; color: ${accent}; }
#AccountCenterCard {
    background: ${surface}; border: 1px solid ${border}; border-radius: 12px;
}
#AccountCenterValue, #DeviceName { font-weight: 700; color: ${text}; }
#AccountCenterMessage { padding: 10px 12px; border-radius: 8px; }
QLabel#AccountCenterMessage[kind="success"] { background: ${ok_soft}; color: ${ok}; }
QLabel#AccountCenterMessage[kind="error"] { background: ${error_bg}; color: ${error_text}; }
#UsageProgress { min-height: 12px; max-height: 12px; border: none; border-radius: 6px; background: ${surface_sunken}; }
#UsageProgress::chunk { background: ${accent}; border-radius: 6px; }
#DeviceRow { background: ${surface_muted}; border: 1px solid ${border}; border-radius: 9px; }
#DeviceBadge { padding: 4px 8px; border-radius: 7px; font-size: 10px; font-weight: 750; }
QLabel#DeviceBadge[state="current"] { background: ${accent_soft}; color: ${accent}; }
QLabel#DeviceBadge[state="active"] { background: ${ok_soft}; color: ${ok}; }
QLabel#DeviceBadge[state="revoked"] { background: ${neutral_bg}; color: ${neutral_text}; }

/* Subscription plans */
#PlansPage { background: ${canvas}; }
#PlansScroll, #PlansScrollContent { background: transparent; border: none; }
#PlansTitle { font-size: 25px; font-weight: 750; color: ${text}; }
#PlansSubtitle { color: ${text_muted}; }
#PlansMessage { padding: 10px 12px; border-radius: 8px; }
QLabel#PlansMessage[kind="success"] { background: ${ok_soft}; color: ${ok}; }
QLabel#PlansMessage[kind="error"] { background: ${error_bg}; color: ${error_text}; }
#PlanCard {
    background: ${surface}; border: 1px solid ${border}; border-radius: 14px;
}
QFrame#PlanCard[current="true"] { border: 2px solid ${accent}; background: ${accent_soft}; }
#PlanName { font-size: 21px; font-weight: 750; color: ${text}; }
#PlanQuota { font-size: 18px; font-weight: 700; color: ${accent}; }
#PlanDetailLabel { color: ${text_muted}; font-size: 11px; font-weight: 650; }
#PlanDetailValue { color: ${text}; font-size: 13px; font-weight: 750; }
#PlanBadge {
    padding: 4px 9px; border-radius: 8px; background: ${accent_soft};
    color: ${accent}; font-size: 10px; font-weight: 750;
}
#PlanAvailabilityBadge {
    padding: 4px 9px; border-radius: 8px; font-size: 10px; font-weight: 750;
}
QLabel#PlanAvailabilityBadge[availability="available"] { background: ${ok_soft}; color: ${ok}; }
QLabel#PlanAvailabilityBadge[availability="coming_soon"] { background: ${warn_bg}; color: ${warn_text}; }

/* Dialogs and tables */
#HistoryDialog { background: ${canvas}; }
QGroupBox {
    background: ${surface}; border: 1px solid ${border}; border-radius: 12px;
    margin-top: 0; padding: 14px; font-weight: 650; color: ${text};
}
#HistorySearch { min-height: 38px; }
QTableWidget {
    background: ${surface}; alternate-background-color: ${table_alt}; color: ${text};
    border: 1px solid ${border}; border-radius: 10px; gridline-color: ${gridline};
}
QTableWidget::item { padding: 8px 10px; border-bottom: 1px solid ${gridline}; }
QTableWidget::item:selected { background: ${accent_soft}; color: ${text}; }
QHeaderView::section {
    background: ${surface_muted}; color: ${text_muted}; border: none; border-bottom: 1px solid ${border};
    padding: 10px; font-weight: 750; font-size: 10px;
}

/* Console */

/* The left margin keeps a scrollbar off the cards it scrolls, so content can
   use the full page gutter and still line up with the header above it. */
QScrollBar:vertical { width: 8px; margin: 3px 1px 3px 6px; background: transparent; }
QScrollBar::handle:vertical { min-height: 36px; background: ${scrollbar}; border-radius: 4px; }
QScrollBar::handle:vertical:hover { background: ${scrollbar_hover}; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical { background: transparent; }

/* Fleet console */
#FleetPage, #FleetScroll, #FleetScrollContent { background: ${canvas}; border: none; }
#FleetTitle { font-size: 25px; font-weight: 750; color: ${text}; }
#FleetSubtitle, #FleetSearchHint { color: ${text_muted}; }
#FleetSearchHint { font-size: 11px; }
#FleetSearch { min-height: 38px; }
#FleetEmpty { color: ${text_muted}; padding: 40px 0; }
#FleetMessage { padding: 10px 12px; border-radius: 8px; background: ${error_bg}; color: ${error_text}; }
#StationRow {
    background: ${surface}; border: 1px solid ${border}; border-radius: 10px;
}
#StationRow:hover { border-color: ${border_strong}; }
#StationRowName { font-size: 15px; font-weight: 750; color: ${text}; }
#StationRowDetail { font-size: 11px; color: ${text_muted}; }
#StationRowLease {
    padding: 4px 9px; border-radius: 8px; background: ${warn_bg};
    color: ${warn_text}; font-size: 10px; font-weight: 750;
}
#StationRowStatus { font-size: 10px; font-weight: 750; letter-spacing: .5px; padding: 4px 9px; border-radius: 8px; }
QLabel#StationRowStatus[online="true"] { background: ${ok_soft}; color: ${ok}; }
QLabel#StationRowStatus[online="false"] { background: ${neutral_bg}; color: ${neutral_text}; }

/* Station workspace */
#StationWorkspacePage { background: ${console_bg}; }
#WorkspaceTitle { font-size: 17px; font-weight: 750; color: ${console_ink}; }
#WorkspaceOwner { font-size: 11px; color: ${console_muted}; }
#WorkspaceMessage {
    margin: 0 28px; padding: 10px 12px; border-radius: 8px;
    background: ${error_bg}; color: ${error_text};
}
#ControlBar { background: ${console_panel}; border-top: 1px solid ${hairline}; border-bottom: 1px solid ${hairline}; }
#PhaseLabel { font-size: 11px; font-weight: 650; color: ${console_muted}; }
QLabel#PhaseLabel[phase="applied"] { color: ${ok}; }
QLabel#PhaseLabel[phase="failed"] { color: ${error_text}; }
QLabel#PhaseLabel[phase="offline"] { color: ${neutral_text}; }
QLabel#PhaseLabel[phase="view_only"] { color: ${warn_text}; }

/* Control lease */
#LeaseBanner { border-bottom: 1px solid ${hairline}; }
#LeaseLabel { font-size: 12px; font-weight: 650; }
QFrame#LeaseBanner[lease="self"] { background: ${ok_soft}; }
QFrame#LeaseBanner[lease="self"] #LeaseLabel { color: ${ok}; }
QFrame#LeaseBanner[lease="other"] { background: ${warn_bg}; }
QFrame#LeaseBanner[lease="other"] #LeaseLabel { color: ${warn_text}; }
QFrame#LeaseBanner[lease="none"] { background: ${console_panel}; }
QFrame#LeaseBanner[lease="none"] #LeaseLabel { color: ${console_muted}; }

/* Workspace tabs: an underline strip like the phone's, full width, equal tabs */
#LivePage { background: ${console_bg}; }
#WorkspaceTabs { background: ${console_panel}; border: none; border-bottom: 1px solid ${hairline}; }
QPushButton#WorkspaceTab {
    min-height: 44px; padding: 0 22px; border: none; border-radius: 0;
    border-bottom: 3px solid transparent; background: transparent;
    color: ${console_muted}; font-size: 13px; font-weight: 500;
}
QPushButton#WorkspaceTab:hover { background: ${button_hover}; color: ${console_ink}; border-color: transparent; }
QPushButton#WorkspaceTab[current="true"] {
    color: ${console_ink}; font-weight: 800; border-bottom: 3px solid ${accent};
}

/* Control tab. Product surface, as on the phone: bordered cards with radii.
   The tab paints the page; everything inside is transparent unless a rule
   below gives it a surface. Rules carry the tab id so they outrank that. */
#ControlTab { background: ${console_bg}; }
#ControlTab QWidget { background: transparent; }
#ControlTab QFrame#ControlPanel, #ControlTab QFrame#InstrumentCell {
    background: ${surface}; border: 1px solid ${border}; border-radius: 16px;
}
/* One caption style above every card, so the strip, chart and helm headings line up. */
#ControlTab #ControlCaption, #ControlTab #PanelLabel { font-size: 13px; font-weight: 700; letter-spacing: .6px; color: ${text_secondary}; padding-left: 4px; }
#ControlTab #InstrumentLabel { font-size: 10px; font-weight: 700; letter-spacing: .6px; color: ${text_secondary}; }
#ControlTab #InstrumentValue { font-size: 28px; font-weight: 700; color: ${text}; }
#ControlTab #InstrumentUnit { font-size: 12px; font-weight: 600; color: ${text_secondary}; }
#ControlTab #GpsCoordinate { font-size: 14px; font-weight: 700; color: ${text}; }
#ControlTab #FieldLabel { font-size: 10px; font-weight: 700; letter-spacing: .8px; color: ${text_secondary}; }
#ControlTab #FieldValue { font-size: 14px; font-weight: 700; color: ${text}; }
#ControlTab QFrame#SimNotice {
    background: ${warn_bg}; border: none; border-left: 3px solid ${warn_icon};
    border-top-right-radius: 10px; border-bottom-right-radius: 10px;
}
#ControlTab #SimNoticeText { font-size: 12px; color: ${text_secondary}; }
#ControlTab QPushButton#ModeButton {
    min-height: 46px; padding: 0 14px; border-radius: 12px;
    background: ${surface}; color: ${text_secondary}; border: 1px solid ${border};
    font-size: 13px; font-weight: 700;
}
#ControlTab QPushButton#ModeButton:hover { background: ${button_hover}; border-color: ${border_strong}; }
#ControlTab QPushButton#ModeButton[selected="true"] { background: ${accent}; color: ${on_accent}; border-color: ${accent}; }
#ControlTab QLabel#SteeringStateChip { padding: 4px 9px; border-radius: 6px; font-size: 10px; font-weight: 800; letter-spacing: .6px; }
#ControlTab QLabel#SteeringStateChip[manual="true"] { background: ${accent_soft}; color: ${accent}; }
#ControlTab QLabel#SteeringStateChip[manual="false"] { background: ${surface_sunken}; color: ${text_secondary}; }
#ControlTab #SteeringAngle { font-size: 40px; font-weight: 700; color: ${text}; }
#ControlTab #SteeringAngle:disabled { color: ${text_secondary}; }
#ControlTab #DirectionPill {
    padding: 5px 10px; border-radius: 13px; background: ${surface_sunken};
    color: ${text_secondary}; font-size: 12px; font-weight: 700;
}
#ControlTab #RudderLabel { font-size: 10px; font-weight: 700; letter-spacing: .6px; color: ${text_secondary}; }
#ControlTab #SteeringAutoNote { font-size: 12px; color: ${text_secondary}; }
#ControlTab QPushButton#NudgeButton {
    min-width: 46px; max-width: 46px; min-height: 46px; max-height: 46px; padding: 0;
    border: none; border-radius: 12px; background: ${surface_sunken};
}
#ControlTab QPushButton#NudgeButton:hover { background: ${button_pressed}; }
#ControlTab QPushButton#NudgeButton:disabled { background: ${button_disabled_bg}; }
#ControlTab QPushButton#CenterButton {
    min-height: 46px; border-radius: 12px; background: transparent;
    color: ${accent}; border: 1px solid ${border_strong}; font-size: 13px; font-weight: 700;
}
#ControlTab QPushButton#CenterButton:hover { background: ${accent_soft}; }
#ControlTab QPushButton#CenterButton:disabled { color: ${text_disabled}; border-color: ${border}; }
#ControlTab QFrame#TelemetryFooter { border: none; border-top: 1px solid ${border}; }
#ControlTab #FooterText { font-size: 11px; letter-spacing: .5px; color: ${text_secondary}; }

/* Transmit */
#TxPanel { background: ${console_panel}; border-top: 1px solid ${hairline}; }
#TxTitle { font-size: 10px; font-weight: 750; letter-spacing: .8px; color: ${console_muted}; }
#TxRecordButton { min-width: 150px; background: ${transmit}; color: ${on_transmit}; border-color: ${transmit}; font-weight: 750; }
#TxRecordButton:hover { background: ${transmit_hover}; border-color: ${transmit_hover}; }
QPushButton#TxRecordButton[recording="true"] { background: ${transmit}; border-color: ${transmit}; }
#TxStatus { font-size: 11px; font-weight: 650; color: ${console_muted}; }
QLabel#TxStatus[phase="failed"] { color: ${error_text}; }
QLabel#TxStatus[phase="completed"] { color: ${ok}; }
QLabel#TxStatus[phase="transmitting"] { color: ${transmit}; }
#TxReview { background: ${console_panel}; border: 1px solid ${hairline}; border-radius: 10px; }
#TxTranscript { font-size: 13px; color: ${text_secondary}; }
#TxTranslation {
    background: ${input_bg}; border: 1px solid ${input_border}; border-radius: 8px;
    padding: 6px 9px; font-size: 14px; color: ${text};
}

#ThemeToggle {
    background: transparent; border: 1px solid transparent;
    border-radius: 8px; padding: 0;
}
#ThemeToggle:hover { background: ${button_hover}; border-color: ${border}; }

/* Feed state indicators -- properties, not inline stylesheets, so a theme
   switch repaints them like everything else. */
QLabel#ListeningDot[state="listening"], QLabel#ListeningLabel[state="listening"] { color: ${ok}; }
QLabel#ListeningDot[state="recording"], QLabel#ListeningLabel[state="recording"] { color: ${console_accent}; }
QLabel#ListeningDot[state="starting"], QLabel#ListeningLabel[state="starting"] { color: ${warn_icon}; }
QLabel#ListeningDot[state="stopping"], QLabel#ListeningLabel[state="stopping"] { color: ${warn_icon}; }
QLabel#ListeningDot[state="error"], QLabel#ListeningLabel[state="error"] { color: ${transmit}; }
QLabel#ListeningDot[state="stopped"], QLabel#ListeningLabel[state="stopped"] { color: ${console_muted}; }
QLabel#GcsDot[api="ok"], QLabel#GcsLabel[api="ok"] { color: ${ok}; }
QLabel#GcsDot[api="ready"], QLabel#GcsLabel[api="ready"] { color: ${console_accent}; }
QLabel#GcsDot[api="retry"], QLabel#GcsLabel[api="retry"],
QLabel#GcsDot[api="starting"], QLabel#GcsLabel[api="starting"] { color: ${warn_icon}; }
QLabel#GcsDot[api="error"], QLabel#GcsLabel[api="error"] { color: ${transmit}; }
QLabel#GcsDot[api="off"], QLabel#GcsLabel[api="off"] { color: ${console_muted}; }

#AuthMessage { font-size: 12px; }
QLabel#AuthMessage[kind="success"] { color: ${ok}; }
QLabel#AuthMessage[kind="error"] { color: ${error_text}; }

/* Containers inside a card must not repaint the page canvas behind them --
   the generic QWidget rule above would otherwise draw a box inside the card. */
#AuthTabPage, #AuthDivider { background: transparent; }
#AuthDividerLine { background: ${border}; border: none; min-height: 1px; max-height: 1px; }
/* QTabWidget wraps its pages in a QStackedWidget, which the generic QWidget
   rule would paint with the canvas -- a dark box inside the card in dark mode. */
QTabWidget QStackedWidget { background: transparent; }

QCheckBox::indicator {
    width: 16px; height: 16px; border-radius: 4px;
    border: 1px solid ${input_border}; background: ${input_bg};
}
QCheckBox::indicator:hover { border-color: ${focus}; }
QCheckBox::indicator:checked { background: ${accent}; border-color: ${accent}; }

/* Typography -- the split console_palette.dart makes on the phone.
   Archivo for captions and headings, Roboto Mono for states and numerals.
   Every list ends in a system face so a missing font degrades, not breaks. */
#LangLabel, #FeedHeader, #TxTitle, #ChatSource {
    font-family: "Archivo", "Segoe UI", sans-serif; font-weight: 700; font-size: 10px;
}
#RxLabel, #PhaseLabel, #ListeningLabel, #GcsLabel {
    font-family: "Roboto Mono", "Consolas", monospace; font-weight: 700;
}
#RxLabel { font-size: 12px; color: ${console_ink}; }
#FleetTitle, #AccountTitle, #AccountCenterTitle, #PlansTitle, #PlanName, #WorkspaceTitle {
    font-family: "Archivo", "Segoe UI", sans-serif; font-weight: 700;
}

/* Assigned in account_center.py but previously unstyled. */
#AccountBackButton { background: transparent; border: 1px solid ${border}; }
#AccountBackButton:hover { background: ${button_hover}; border-color: ${border_strong}; }
#GoogleLinkButton { background: ${surface}; color: ${text}; border: 1px solid ${border_strong}; font-weight: 700; }
#GoogleLinkButton:hover { background: ${surface_muted}; border-color: ${focus}; }
