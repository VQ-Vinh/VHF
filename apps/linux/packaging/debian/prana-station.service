[Unit]
Description=PRANA ELEX headless audio station
After=network-online.target sound.target
Wants=network-online.target

[Service]
Type=simple
User=prana-elex
Group=prana-elex
# Raspberry Pi OS gives /dev/gpiochip* to the gpio group; Ubuntu's own
# 60-gpio.rules gives it to dialout. Join both rather than overriding a
# distro's udev rule, which would take the device away from whoever the
# distro meant to have it.
SupplementaryGroups=audio gpio dialout
WorkingDirectory=/var/lib/prana-elex
Environment=XDG_CONFIG_HOME=/var/lib/prana-elex/.config
ExecStart=/usr/bin/prana-station
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
